{
    "mcpServers": {
        "atlassian": {
            "command": "npx",
            "args": [
                "-y",
                "mcp-remote",
                "https://mcp.atlassian.com/v1/mcp/authv2"
            ]
        },
        "gdrive": {
            "command": "node",
            "args": [
                "./gdrive/dist/index.js"
            ]
        }
    }
}